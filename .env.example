# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these to configure the db and backend containers.

# WARNING: these credentials are only applied when the `pgdata` Docker volume is
# first created. Changing them later requires `docker compose down -v` (which
# destroys the database) — Postgres will not pick up the new password otherwise.
DB_USERNAME=syncup
DB_PASSWORD=changeme
DB_DATABASE=syncup
JWT_SECRET=change-this-to-a-long-random-string
BCRYPT_SALT_ROUNDS=10

# CORS origin allowed by the backend. Must match the URL users open in their browser.
# For local docker-compose this defaults correctly; set it explicitly for non-localhost deployments.
ALLOWED_ORIGIN=http://localhost:4200

# Host ports — change if any of these are already taken on your machine.
DB_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=4200
