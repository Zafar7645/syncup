server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # The Angular bundle calls relative /api/* paths so it never needs to know
  # the backend's real address — Nginx forwards to it over the private network
  # and strips the /api prefix, since the backend's routes live at the root.
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
